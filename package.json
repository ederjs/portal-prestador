{
  "name": "portal-prestador",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/typescript/bin/tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b --noEmit",
    "postinstall": "node -e \"const fs=require('fs');const dir='node_modules/.bin';try{for(const f of fs.readdirSync(dir)){try{fs.chmodSync(dir+'/'+f,0o755)}catch(e){}}}catch(e){}\""
  },
  "dependencies": {
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.1"
  }
}
